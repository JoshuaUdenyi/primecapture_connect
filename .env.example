# Copy to .env.local for a REAL Supabase-backed development workspace.
# For a credential-free simulation use npm run dev:demo instead.
APP_BASE_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate 32 random bytes as 64 hex characters; store in a secret manager.
TOKEN_ENCRYPTION_KEY=
# Google Cloud OAuth client of type Web application; enable YouTube Data API v3.
# Redirect URI: APP_BASE_URL + /youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
DEMO_MODE=false
MOCK_META_ENABLED=false
# These flags DO NOT override the hard release gates in lib/config.ts.
META_PAGE_PUBLISH_ENABLED=false
META_BUSINESS_REQUEST_ENABLED=false
META_PROFILE_PUBLISH_ENABLED=false
META_APP_ID=
META_APP_SECRET=
# Set only after choosing and verifying the current supported version in Meta.
META_GRAPH_VERSION=
META_BUSINESS_ID=
